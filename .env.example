# ==============================================================================
# EduGester Environment Configuration
# ==============================================================================

# Database URL (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./edugester.db

# Redis URL (Live room state & presence)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=edugester_jwt_secret_key_super_secure_9923
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend & Backend Endpoints
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080

# WebRTC STUN/TURN Servers
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=
